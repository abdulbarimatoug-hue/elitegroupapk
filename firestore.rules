rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'admin')
      );
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.staff == true ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'staff')
      );
    }

    // Admins & Staff authorization control collections
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaffOrAdmin();
      allow create: if isOwner(userId);
      // User can update their profile but cannot escalate their role unless admin
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
      allow list: if isStaffOrAdmin();
    }

    // Travel Packages (الباقات السياحية العامة)
    // Public read for all users, write restricted to admins only
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Package Bookings (حجوزات الباقات السياحية)
    match /bookings/{bookingId} {
      // Customer creates their own booking in pending state
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      
      // Customer reads their own; staff/admin can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      
      // Customer can only cancel their pending booking; staff/admin can update any status
      allow update: if isStaffOrAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'cancelled' &&
        resource.data.status == 'pending'
      );
      
      // Only admin can delete bookings records
      allow delete: if isAdmin();
    }

    // Visa definitions & pricing catalog (كتالوج التأشيرات والدول)
    // Public read for everyone, write restricted to admins only
    match /visa_catalog/{visaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visa requests (طلبات التأشيرة)
    match /visa_requests/{requestId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Custom Trip Requests (طلبات مصمم الرحلة المخصصة - معالج الـ 6 خطوات)
    match /custom_trip_requests/{requestId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Flight Booking Requests (طلبات حجز تذاكر الطيران المستقلة)
    match /flight_booking_requests/{requestId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
      allow update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Custom Trip Master Data (محددات وقوائم مصمم الرحلة)
    match /trip_builder_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Subcollections (e.g. favorites, notifications)
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isStaffOrAdmin();
      allow write: if isStaffOrAdmin() || isOwner(userId);
    }

    match /users/{userId}/{subcollection=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
